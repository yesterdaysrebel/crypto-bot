# Copy this file to terraform.tfvars and update with your values
# DO NOT commit terraform.tfvars to version control

# AWS Configuration
aws_region       = "ap-south-1"
instance_type    = "t4g.micro"  # ARM-based, 20% cheaper than t3.micro (recommended)
ssh_key_name     = "your-ssh-key-name"  # REQUIRED: Your AWS SSH key pair name

# Instance Configuration
use_spot_instance = true  # Use spot instances for cost savings (up to 90% cheaper)
spot_price       = ""     # Leave empty to use on-demand price
spot_type        = "persistent"  # "one-time" (won't restart if interrupted) or "persistent" (auto-restarts - RECOMMENDED)
                                 # persistent = cheapest + reliable (auto-restarts if interrupted)

# Network Configuration
create_vpc       = false  # Set to true to create dedicated VPC (more secure, more cost)
enable_public_ip = true   # Assign public IP to instance
use_elastic_ip   = false  # Allocate Elastic IP for static IP (costs extra)

# Security Configuration
# Restrict SSH access to your IP for better security
# Find your IP: https://whatismyipaddress.com/
allowed_ssh_cidr = [
  "0.0.0.0/0"  # ⚠️ CHANGE THIS to your IP, e.g., "123.45.67.89/32"
]

# Storage Configuration
ebs_volume_size  = 8      # Root volume size in GB (minimum 8 for Amazon Linux)
ebs_volume_type  = "gp3"  # gp3 is cheapest and fastest
ebs_encrypted     = true   # Enable encryption for EBS volumes

# Monitoring Configuration
enable_detailed_monitoring = false  # Enable detailed CloudWatch monitoring (costs extra)
enable_termination_protection = false  # Enable termination protection (disable for spot instances)
backup_retention_days = 7  # Number of days to retain CloudWatch logs

# Tagging
environment = "production"
project_name = "trading-bot"
