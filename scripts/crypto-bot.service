[Unit]
Description=Delta Exchange Crypto Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/crypto-bot
EnvironmentFile=/opt/crypto-bot/.env
ExecStart=/opt/crypto-bot/.venv/bin/python /opt/crypto-bot/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
