DELTA_API_KEY=
DELTA_API_SECRET=

# Delta Exchange India base URL (production)
BASE_URL=https://api.india.delta.exchange

# Product symbol (example: SOLUSD)
SYMBOL=SOLUSD
# Optional numeric product id (overrides SYMBOL lookup if set)
PRODUCT_ID=

# Optional asset id for quote currency balance lookup (e.g. USDT asset id)
QUOTE_ASSET_ID=

# Risk configuration
ACCOUNT_EQUITY=50000
DAILY_CAPITAL=10000
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_WEEKLY_LOSS=0.05
MAX_DRAWDOWN=0.15
LEVERAGE=25

# Strategy configuration
EMA_FAST=20
EMA_SLOW=50
VWAP_LOOKBACK=50
STOP_PCT=0.004
TAKE_PROFIT_R=1.5
TAKE_PROFIT_ENABLED=true

# Execution
ENTRY_ORDER_TYPE=market
TIME_IN_FORCE=gtc
POST_ONLY=false
REDUCE_ONLY=true
MIN_QTY=0.1
QTY_STEP=0.1
TIMEFRAME=1m
CANDLE_LIMIT=200
POLL_SECONDS=10
MIN_SECONDS_BETWEEN_TRADES=60
MAX_TRADES_PER_DAY=4

# Safety (set true to disable live orders)
DRY_RUN=true

# Journaling
JOURNAL_PATH=journals/trade_journal.csv
LOG_TRADES=true

# Logging
LOG_LEVEL=INFO
