DELTA_API_KEY=
DELTA_API_SECRET=

# Delta Exchange India base URL (production)
BASE_URL=https://api.india.delta.exchange

# Product symbol (example: SOLUSD)
SYMBOL=SOLUSD
# Optional numeric product id (overrides SYMBOL lookup if set)
PRODUCT_ID=

# Optional asset id for quote currency balance lookup (e.g. USDT asset id)
QUOTE_ASSET_ID=

# Risk configuration
ACCOUNT_EQUITY=50000
DAILY_CAPITAL=10000
RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.02
MAX_WEEKLY_LOSS=0.05
MAX_DRAWDOWN=0.15
LEVERAGE=25

# ============================================================================
# STRATEGY SELECTION
# ============================================================================
# Set to true for Breakout + Momentum Strategy (recommended for SOLUSD)
# Set to false for Basic Trend Following Strategy
USE_BREAKOUT_STRATEGY=true

# ============================================================================
# BASIC STRATEGY CONFIGURATION (used when USE_BREAKOUT_STRATEGY=false)
# ============================================================================
# EMA periods for trend detection
EMA_FAST=20
EMA_SLOW=50
VWAP_LOOKBACK=50

# ============================================================================
# ADVANCED STRATEGY CONFIGURATION (used when USE_BREAKOUT_STRATEGY=true)
# ============================================================================
# ATR-based dynamic stops (adapts to volatility - recommended for SOL)
USE_ATR_STOPS=true
ATR_PERIOD=14
ATR_MULTIPLIER=2.0

# RSI settings for momentum filtering
RSI_PERIOD=14
RSI_OVERBOUGHT=75
RSI_OVERSOLD=25

# Bollinger Bands for breakout detection
BB_PERIOD=20
BB_STD_DEV=2.0

# Volume surge multiplier (1.3 = 30% above average - more sensitive)
VOLUME_SURGE_MULTIPLIER=1.3

# Fallback fixed stop percentage (only used if USE_ATR_STOPS=false)
STOP_PCT=0.01

# Risk/Reward ratio (2.5 = target is 2.5x the stop distance)
TAKE_PROFIT_R=2.5
TAKE_PROFIT_ENABLED=true

# ============================================================================
# PARTIAL PROFIT TAKING (Pyramiding Strategy)
# ============================================================================
# Enable partial profit taking at 2:1, then trail the rest
PARTIAL_PROFIT_ENABLED=true
# Take profit on 50% of position at 2:1 ratio
PARTIAL_PROFIT_PCT=0.5
# First profit target at 2:1 (lock in guaranteed win)
PARTIAL_PROFIT_R=2.0

# Execution
ENTRY_ORDER_TYPE=market
TIME_IN_FORCE=gtc
POST_ONLY=false
REDUCE_ONLY=true
MIN_QTY=0.1
MAX_QTY=20
QTY_STEP=0.1
FIXED_QTY=0
PRICE_SOURCE=mark
# 1h timeframe - swing trading for bigger moves
TIMEFRAME=1h
CANDLE_LIMIT=200
# Poll every 60 seconds (1 hour candles form slowly)
POLL_SECONDS=60
# 2 hour cooldown between trades (2 candle periods)
MIN_SECONDS_BETWEEN_TRADES=7200
# Up to 2 high-quality swing setups per day
MAX_TRADES_PER_DAY=2

# Safety (set true to disable live orders)
DRY_RUN=true

# Journaling
JOURNAL_PATH=journals/trade_journal.csv
LOG_TRADES=true
ENFORCE_TRADE_LIMITS=false

# Logging
LOG_LEVEL=DEBUG
