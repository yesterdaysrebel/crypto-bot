DELTA_API_KEY=
DELTA_API_SECRET=

# Delta Exchange India base URL (production)
BASE_URL=https://api.india.delta.exchange

# Product symbol (example: SOLUSD)
SYMBOL=MUSD
# Optional numeric product id (overrides SYMBOL lookup if set)
PRODUCT_ID=

# Optional asset id for quote currency balance lookup (e.g. USDT asset id)
QUOTE_ASSET_ID=

# Risk configuration
ACCOUNT_EQUITY=50000
DAILY_CAPITAL=10000
RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.02
MAX_WEEKLY_LOSS=0.05
MAX_DRAWDOWN=0.15
LEVERAGE=25

# Strategy configuration (optimized swing trading)
# Faster EMAs (20/50) catch trends earlier than 50/200
EMA_FAST=20
EMA_SLOW=50
VWAP_LOOKBACK=50
# 0.8% stop loss - tighter for better risk/reward
STOP_PCT=0.008
# 2.0 risk/reward ratio - targeting 1.6% profit per trade
TAKE_PROFIT_R=2.0
TAKE_PROFIT_ENABLED=true

# Execution
ENTRY_ORDER_TYPE=market
TIME_IN_FORCE=gtc
POST_ONLY=false
REDUCE_ONLY=true
MIN_QTY=0.1
QTY_STEP=0.1
FIXED_QTY=0
PRICE_SOURCE=mark
# 15m timeframe - more signals than 1h, still swing-appropriate
TIMEFRAME=15m
CANDLE_LIMIT=200
# Poll every 30 seconds to catch new candles
POLL_SECONDS=30
# 15 minute cooldown between trades (1 candle period)
MIN_SECONDS_BETWEEN_TRADES=900
# Up to 4 swing trades per day
MAX_TRADES_PER_DAY=4

# Safety (set true to disable live orders)
DRY_RUN=true

# Journaling
JOURNAL_PATH=journals/trade_journal.csv
LOG_TRADES=true
ENFORCE_TRADE_LIMITS=false

# Logging
LOG_LEVEL=DEBUG
