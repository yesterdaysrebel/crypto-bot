DELTA_API_KEY=
DELTA_API_SECRET=

# Delta Exchange India base URL (production)
BASE_URL=https://api.india.delta.exchange

# Product symbol (example: SOLUSD)
SYMBOL=SOLUSD
# Optional numeric product id (overrides SYMBOL lookup if set)
PRODUCT_ID=

# Optional asset id for quote currency balance lookup (e.g. USDT asset id)
QUOTE_ASSET_ID=

# Risk configuration
ACCOUNT_EQUITY=50000
DAILY_CAPITAL=10000
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_WEEKLY_LOSS=0.05
MAX_DRAWDOWN=0.15
LEVERAGE=25

# Strategy configuration (swing-ish defaults for 1h)
EMA_FAST=50
EMA_SLOW=200
# Trend filter: only long when price > TREND_EMA, only short when price < TREND_EMA (stops buying in downtrends). Set 0 to disable.
TREND_EMA_PERIOD=100
VWAP_LOOKBACK=100
STOP_PCT=0.01

# Risk/Reward ratio (1.5 = target is 1.5x the stop distance)
TAKE_PROFIT_R=1.5
TAKE_PROFIT_ENABLED=true
TRAILING_STOP_ENABLED=false

# Strategy selector (only enable one strategy toggle at a time)
USE_HYBRID_STRATEGY=false
USE_MTF_REGIME=true
USE_REGIME_TREND=false
USE_BREAKOUT_STRATEGY=false

# Multi-timeframe mode (4h trend bias + 1h entries)
TREND_TIMEFRAME=4h
ENTRY_TIMEFRAME=1h

# Regime trend settings
REGIME_FAST_EMA=50
REGIME_SLOW_EMA=200
REGIME_PULLBACK_EMA=20
REGIME_ADX_PERIOD=14
REGIME_ADX_MIN=22
# Minimum ATR as percentage of price (0.8 = 0.8%)
REGIME_ATR_PCT_MIN=0.8
# ATR multiple used for stop distance (and target = R x stop)
ATR_MULTIPLIER=1.5

# Hybrid strategy settings (used only when USE_HYBRID_STRATEGY=true)
HYBRID_TREND_ADX_MIN=22
HYBRID_RANGE_ADX_MAX=16
HYBRID_RANGE_RR=1.2
HYBRID_RANGE_STOP_ATR_MULTIPLIER=1.2

# ============================================================================
# PARTIAL PROFIT TAKING (Pyramiding Strategy)
# ============================================================================
# Enable partial profit taking at 2:1, then trail the rest
PARTIAL_PROFIT_ENABLED=false
# Take profit on 50% of position at 2:1 ratio
PARTIAL_PROFIT_PCT=0.5
# First profit target at 2:1 (lock in guaranteed win)
PARTIAL_PROFIT_R=2.0

# Execution
ENTRY_ORDER_TYPE=market
TIME_IN_FORCE=gtc
POST_ONLY=false
REDUCE_ONLY=true
MIN_QTY=0.1
# 0 disables qty cap; prefer MAX_NOTIONAL_USD so the cap scales with price.
MAX_QTY=0
# Hard cap on notional ($). At SOL=$93 and 0.5% risk, $2000 notional ≈ 21 SOL.
MAX_NOTIONAL_USD=2000
QTY_STEP=0.1
FIXED_QTY=0
PRICE_SOURCE=mark
# Default single-timeframe fallback (used when USE_MTF_REGIME=false)
TIMEFRAME=1h
CANDLE_LIMIT=200
# Poll every 60 seconds (1 hour candles form slowly)
POLL_SECONDS=60
# 2 hour cooldown between trades (2 candle periods)
MIN_SECONDS_BETWEEN_TRADES=7200
# Up to 2 high-quality swing setups per day
MAX_TRADES_PER_DAY=2

# Safety (set true to disable live orders; set false for live trading)
DRY_RUN=true

# Journaling
JOURNAL_PATH=journals/trade_journal.csv
ANALYTICS_PATH=analytics/decision_log.csv
OUTCOMES_PATH=journals/trade_outcomes.csv
LOG_TRADES=true
ENFORCE_TRADE_LIMITS=true

# Logging
LOG_LEVEL=INFO
